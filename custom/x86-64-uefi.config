# =============================================================================
# lede (coolsnowwolf) x86-64 UEFI 构建种子配置 —— 完整版 + 解决 libustream 冲突
# 说明：保留完整默认软件包；仅修复 libustream（openssl/mbedtls 二选一，避免 file clash）
# 用途：cp 到 .config 后执行 `make defconfig` 展开为完整配置（非交互，适合 CI）
# =============================================================================

# --- 目标平台 ---
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y

# --- 根文件系统：squashfs（只读、可恢复出厂，符合 QWRT 格式）---
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# --- 镜像压缩为 gzip ---
CONFIG_TARGET_IMAGES_GZIP=y

# --- 预装 LuCI Web 界面（含基础中文）---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# --- 修复 libustream 冲突：这两者互斥，只能选一个。
#     保留 openssl 版（luci-ssl 依赖它），关掉 mbedtls 版，否则 file clash 导致编译失败 ---
CONFIG_PACKAGE_libustream-openssl=y
# CONFIG_PACKAGE_libustream-mbedtls is not set
